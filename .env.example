# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: console.debug logging for src/lib/analytics.ts's instrumentation stub
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Database (local defaults; use isolated credentials and databases outside local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/austechmap
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/austechmap

# Ingestion
APP_ENV=development
APP_RELEASE=local
LOG_LEVEL=INFO
SENTRY_DSN=
RAW_SNAPSHOT_BACKEND=filesystem
RAW_SNAPSHOT_BUCKET=austechmap-raw-local
RAW_SNAPSHOT_ROOT=.local/raw-snapshots
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
