# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: console.debug logging for src/lib/analytics.ts's instrumentation stub
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Database (local defaults; use isolated credentials and databases outside local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/austechmap
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/austechmap

# Ingestion
APP_ENV=development
APP_RELEASE=local
LOG_LEVEL=INFO
SENTRY_DSN=
RAW_SNAPSHOT_BACKEND=filesystem
RAW_SNAPSHOT_BUCKET=austechmap-raw-local
RAW_SNAPSHOT_ROOT=.local/raw-snapshots
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Auth (ARCHITECTURE_DECISIONS.md §4.1)
AUTH_SECRET=
# No real Resend account/verified domain exists yet -- the sandbox sender
# only delivers to the account owner's own address, a deliberate, named
# interim state (see auth.ts). Swap AUTH_RESEND_FROM once a domain is
# verified; nothing else changes.
AUTH_RESEND_KEY=
AUTH_RESEND_FROM=onboarding@resend.dev
# AES-256-GCM key for TOTP seed encryption, base64-encoded, 32 bytes
# decoded. Must be set as a Vercel *sensitive* environment variable in
# production, never a plain one (see lib/mfa/crypto.ts).
MFA_ENCRYPTION_KEY_V1=
MFA_ENCRYPTION_CURRENT_VERSION=1
# age recipient (public key) for the account-deletion restore-suppression
# ledger (§4.1 step 4) -- the app only ever encrypts; the matching private
# identity is operator-held, outside Vercel/Neon/R2/repo, mirroring §4.4's
# backup-encryption pattern.
DELETION_LEDGER_AGE_RECIPIENT=
